# Copy to .env and fill in. Never commit .env.

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/sustainable_db
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin(s) allowed by CORS, comma-separated. Required in production.
CLIENT_URL=http://localhost:5173

# bcrypt cost: 12 in production, 4 makes tests fast
BCRYPT_ROUNDS=12

# Razorpay (test mode keys start with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# true = demo payments, no real money. Never set on a real store
# PAYMENT_SANDBOX=true

# Redis (optional: the app runs without it, cache/queue/socket adapter degrade gracefully)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# DISABLE_REDIS=true

# Cloudinary signed uploads (optional: without these, sellers paste image URLs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# How often expired auctions are closed, in ms (default 30000)
# AUCTION_SWEEP_MS=30000
